# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
# ...but DO track the bundled basis_universal static libs shipped per platform
# (see native/build-basisu.sh). Consider git-lfs for these multi-MB binaries.
!**/libbasisu.a
!**/basisu.lib

# basis_universal source + build output (fetched on demand by native/build-basisu.sh,
# not vendored — only the CI lib-build job or a manual rebuild needs it)
native/basis_universal/
native/build/

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib
# ...but DO track the per-platform libktx shared libs (native/build-shared.sh
# / CI artifacts; loaded via FFI by e.g. the Blender addon) and the linux
# libc++ linker-script shim that redirects -lc++ to libstdc++.
!**/ktx.so
!**/ktx.dylib
!**/ktx.dll
!**/libc++.so

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo
build/
out/
headers/
