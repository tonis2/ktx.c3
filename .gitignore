# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

native/

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
# ...but DO track the bundled zstd static libs shipped per platform
# (see native/build-zstd.sh) — the library's only native dependency.
!**/libzstd.a
!**/zstd.lib

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib
# The per-platform libktx shared libs are NOT tracked: release.yml attaches
# them to the GitHub release of every v* tag as ktx-<triple>.<ext>, and FFI
# consumers (e.g. the Blender addon) download from there. Local builds still
# land in <triple>/ for development.

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo
build/
out/
headers/

# golden decode oracles, regenerated locally by test/gen-golden.sh
test/golden/
