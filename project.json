{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  "dependencies": ["getopt", "image"],
  "authors": [ "Tonis" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  // Output location, relative to project file.
  "output": "build",
  // The only native dependency: zstd (bound in src/ktx/zstd.c3), a prebuilt
  // static lib per platform under lib/<arch>/libzstd.a (native/build-zstd.sh).
  // The ETC1S/UASTC codec is pure C3 (src/ktx/{uastc,etc1s,basis}.c3).
  // The top level is what plain `c3c build`/`c3c test` link with: zstd from
  // the linux dirs. Every other platform target *overrides* both lists rather
  // than adding to them (target lists are additive in c3c), because:
  // - the new macOS linker (ld-prime) hard-errors on foreign files found in
  //   search paths instead of skipping them, so a mac target must see only its
  //   own lib directory. On macOS build and test through it: `c3c build ktx`,
  //   `c3c test ktx`;
  // - the windows CLI must NOT get "-l zstd": lld-link never sees the search
  //   paths, so CI passes the zstd.lib path explicitly via -z instead.
  "linked-libraries": [ "zstd" ],
  "linker-search-paths": [ "lib/linux-x64", "lib/linux-aarch64" ],
  "targets": {
    // First, so it is what plain `c3c build` and `c3c test` use.
    "ktx-linux": {
      "type": "executable"
    },
    // The macOS (arm64) CLI, as built by CI.
    "ktx": {
      // Executable or library.
      "type": "executable",
      "linker-search-paths-override": [ "lib/macos-aarch64" ]
    },
    // CI cross-build of the x86_64 mac CLI from the arm64 runner
    // (c3c build ktx-macos-x64 --target macos-x64).
    "ktx-macos-x64": {
      "type": "executable",
      "linker-search-paths-override": [ "lib/macos-x64" ]
    },
    // No zstd here: CI links zstd.lib via -z (see build-native.yml).
    "ktx-windows": {
      "type": "executable",
      "linked-libraries-override": [],
      "linker-search-paths-override": []
    }
  },
  // Global settings.
  // CPU name, used for optimizations in the LLVM backend.
  "cpu": "generic",
  // Optimization: "O0", "O1", "O2", "O3", "O4", "O5", "Os", "Oz".
  "opt": "O0"
  // See resources/examples/project_all_settings.json and 'c3c --list-project-properties' to see more properties.
}