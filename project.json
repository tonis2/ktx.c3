{
  // Language version of C3.
  "langrev": "1",
  // Warnings used for all targets.
  "warnings": [ "no-unused" ],
  // Directories where C3 library files may be found.
  "dependency-search-paths": [ "lib" ],
  "dependencies": ["getopt", "image"],
  "authors": [ "Tonis" ],
  "version": "0.1.0",
  "sources": [ "src/**" ],
  "test-sources": [ "test/**" ],
  "build-dir": "build",
  // Output location, relative to project file.
  "output": "build",
  // The only native dependency: zstd (bound in src/ktx/zstd.c3), a prebuilt
  // static lib per platform under lib/<arch>/libzstd.a (native/build-zstd.sh).
  // The ETC1S/UASTC codec is pure C3 (src/ktx/{uastc,etc1s,basis}.c3).
  "linked-libraries": [ "zstd" ],
  // The new macOS linker (ld-prime) hard-errors on foreign files found in
  // search paths (linux-x64/libbasisu.a, the linux libc++.so shim) instead of
  // skipping them, so each platform gets its own target with only its own
  // lib directory. `c3c build` builds the default (macOS) target; on linux use
  // `c3c build ktx-linux`.
  "linker-search-paths": [ "lib/macos-aarch64" ],
  "targets": {
    "ktx": {
      // Executable or library.
      "type": "executable"
    },
    "ktx-linux": {
      "type": "executable",
      "linker-search-paths": [ "lib/linux-x64", "lib/linux-aarch64" ]
    }
  },
  // Global settings.
  // CPU name, used for optimizations in the LLVM backend.
  "cpu": "generic",
  // Optimization: "O0", "O1", "O2", "O3", "O4", "O5", "Os", "Oz".
  "opt": "O0"
  // See resources/examples/project_all_settings.json and 'c3c --list-project-properties' to see more properties.
}