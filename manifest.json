{
  // Library name. Consumers add "ktx" to their project.json "dependencies"
  // (with this repo on a "dependency-search-paths" entry) and then
  // `import ktx::container, ktx::vk, ktx::bc7, ktx::basis, ...`.
  "provides": "ktx",
  // Only the ktx::* modules are part of the library — the CLI (src/cli, src/main.c3)
  // is intentionally excluded so consumers don't pull in getopt/image.
  "sources": [ "src/ktx/**" ],
  // No C3 library dependencies: ktx::* uses only the standard library.
  "dependencies": [],
  // The one native dependency: zstd (bound in src/ktx/zstd.c3), bundled as a
  // prebuilt static lib per target at <target>/libzstd.a (native/build-zstd.sh).
  // Plain C, no runtime baggage — the ETC1S/UASTC codec itself is pure C3
  // (src/ktx/{uastc,etc1s,basis}.c3), so no C++ runtime is linked.
  "targets": {
    "macos-aarch64": {
      "linked-libraries": [ "zstd" ]
    },
    "macos-x64": {
      "linked-libraries": [ "zstd" ]
    },
    "linux-x64": {
      "linked-libraries": [ "zstd" ]
    },
    "linux-aarch64": {
      "linked-libraries": [ "zstd" ]
    },
    "windows-x64": {
      "linked-libraries": [ "zstd" ]
    }
  }
}
