{
  // Library name. Consumers add "ktx" to their project.json "dependencies"
  // (with this repo on a "dependency-search-paths" entry) and then
  // `import ktx::container, ktx::vk, ktx::bc7, ktx::basis, ...`.
  "provides": "ktx",
  // Only the ktx::* modules are part of the library — the CLI (src/cli, src/main.c3)
  // is intentionally excluded so consumers don't pull in getopt/image.
  "sources": [ "src/ktx/**" ],
  // No C3 library dependencies: ktx::* uses only the standard library.
  "dependencies": [],
  // Native dependency: basis_universal (ETC1S/UASTC + BasisLZ, via src/ktx/basis.c3).
  // Each target links the prebuilt static lib bundled at <target>/libbasisu.a, which
  // basis_universal is C++, so a C++ runtime is linked per platform (-lc++ / -lstdc++).
  // basis bundles a full zstd that also satisfies the container's ZSTD_* calls, so
  // NO separate system libzstd is required.
  "targets": {
    "macos-aarch64": {
      "linked-libraries": [ "basisu" ],
      "link-args": [ "-lc++" ]
    },
    "macos-x64": {
      "linked-libraries": [ "basisu" ],
      "link-args": [ "-lc++" ]
    },
    "linux-x64": {
      "linked-libraries": [ "basisu" ],
      "link-args": [ "-lstdc++", "-lm", "-lpthread" ]
    },
    "linux-aarch64": {
      "linked-libraries": [ "basisu" ],
      "link-args": [ "-lstdc++", "-lm", "-lpthread" ]
    },
    "windows-x64": {
      // MSVC links the C++ runtime automatically.
      "linked-libraries": [ "basisu" ]
    }
  }
}
